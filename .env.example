NODE_ENV=local

# api
PORT=3000

# postgres
POSTGRES_USER=academistream
POSTGRES_PASSWORD=academistream
POSTGRES_DB=academistream
DATABASE_URL=postgres://academistream:academistream@localhost:5432/academistream

# redis
REDIS_URL=redis://localhost:6379

# kafka
KAFKA_BROKERS=localhost:29092

# local seed only (not for production)
SEED_PLATFORM_EMAIL=platform@academistream.local
SEED_PASSWORD=Password123!

# JWT
JWT_SECRET='secret'

# web (CORS; Vite also proxies /api → API in local dev)
WEB_ORIGIN=http://localhost:5173

# media storage (local adapter is active; S3 unused until uncommented)
STORAGE_LOCAL_ROOT=./.data/media
# Future S3 (not used yet — see apps/api/src/storage)
# S3_BUCKET=
# AWS_REGION=eu-central-1