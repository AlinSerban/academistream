NODE_ENV=local

# api
PORT=3000

# postgres
POSTGRES_USER=academistream
POSTGRES_PASSWORD=academistream
POSTGRES_DB=academistream
DATABASE_URL=postgres://academistream:academistream@localhost:5432/academistream

# redis
REDIS_URL=redis://localhost:6379

# kafka (API produces upload jobs; worker consumes in S2-05)
KAFKA_BROKERS=localhost:29092
KAFKA_VIDEO_TOPIC=video.processing

# local seed only (not for production)
SEED_PLATFORM_EMAIL=platform@academistream.local
SEED_PASSWORD=Password123!

# JWT
JWT_SECRET='secret'

# web (CORS; Vite also proxies /api → API in local dev)
WEB_ORIGIN=http://localhost:5173

# media storage — local is default (dev/CI). AWS path: infra/terraform + S6-02+
# Relative paths resolve from the monorepo root (shared by API + worker)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=.data/media

# AWS media (S6-01 baseline — unused until STORAGE_PROVIDER=s3 and adapters are wired in S6-02+)
# Provision with: cd infra/terraform && terraform apply
# Copy values: terraform output s3_bucket_name / mediaconvert_role_arn / aws_region
# Credentials: AWS CLI profile (~/.aws/credentials) or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY
# AWS_REGION=eu-central-1
# S3_BUCKET=
# MEDIACONVERT_ROLE=

# Worker polls GetJob for completion when STORAGE_PROVIDER=s3 (milliseconds, default 15000)
# MEDIACONVERT_POLL_INTERVAL_MS=15000

# CloudFront signed playback (S6-05 — placeholders only)
# CLOUDFRONT_DOMAIN=
# CLOUDFRONT_KEY_PAIR_ID=
# CLOUDFRONT_PRIVATE_KEY_PATH=