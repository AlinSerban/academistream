{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StartStopDescribeDemoInstance",
      "Effect": "Allow",
      "Action": [
        "ec2:StartInstances",
        "ec2:StopInstances",
        "ec2:DescribeInstanceStatus"
      ],
      "Resource": "arn:aws:ec2:eu-central-1:YOUR_AWS_ACCOUNT_ID:instance/i-YOUR_INSTANCE_ID"
    },
    {
      "Sid": "DescribeInstances",
      "Effect": "Allow",
      "Action": [
        "ec2:DescribeInstances"
      ],
      "Resource": "*"
    }
  ]
}
