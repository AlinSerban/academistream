# AWS media path — merge into .env after `terraform apply` (see infra/terraform/README.md).
# Set STORAGE_PROVIDER=s3 on BOTH API and worker processes.

STORAGE_PROVIDER=s3
AWS_REGION=eu-central-1
S3_BUCKET=academistream-dev-media-123456789012
MEDIACONVERT_ROLE=arn:aws:iam::123456789012:role/academistream-dev-mediaconvert

# Worker polls MediaConvert GetJob (milliseconds)
MEDIACONVERT_POLL_INTERVAL_MS=15000

# Optional: CloudFront signed playback (private bucket + OAC distribution)
# CLOUDFRONT_DOMAIN=d111111abcdef8.cloudfront.net
# CLOUDFRONT_KEY_PAIR_ID=APKAI...
# CLOUDFRONT_PRIVATE_KEY_PATH=path/to/cloudfront-private-key.pem

# Credentials: AWS CLI profile or:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
